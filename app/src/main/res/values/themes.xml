<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Piano" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/piano_primary</item>
        <item name="colorPrimaryVariant">@color/piano_primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/piano_secondary</item>
        <item name="colorSecondaryVariant">@color/piano_secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/piano_primary_dark</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/white</item>
        <!-- Prevent Material tint from painting keys purple. -->
        <item name="buttonStyle">@style/Widget.Piano.Button</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Widget.Piano.Button" parent="Widget.AppCompat.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
